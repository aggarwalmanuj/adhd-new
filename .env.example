# Copy this file to .env.local and fill in the real values.
# .env* is gitignored, so secrets never reach the repo. On Vercel, set the
# same names under Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Meta (Facebook) Pixel
# ---------------------------------------------------------------------------
# The numeric pixel id from Meta Events Manager → Data Sources → your pixel.
# Digits only — no quotes, no "fbq(" wrapper, no script tag. The base snippet
# is already implemented in components/facebook-pixel.tsx; this is the only
# value it needs.
#
# The pixel sets cookies, so it is CONSENT-GATED: the script is not injected
# until the visitor accepts the cookie banner. That is deliberate (GDPR) and
# means events will not fire in a browser that has declined or not answered.
#
# Events already wired:
#   PageView        — on load, from the base snippet
#   cta_click       — every CTA, with a `location` (hero, ledger, final, …)
#   ScorecardClick  — legacy Meta custom event existing ad optimisation reads
#   vsl_play / vsl_25 / vsl_50 / vsl_75 / vsl_complete
#   scroll_depth_25 / 50 / 75 / 90
#   walkthrough_step, testimonial_play, faq_open
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# ---------------------------------------------------------------------------
# Canonical site origin (used for metadata, OG tags, sitemap, robots)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://adhd.aimerge.live

# ---------------------------------------------------------------------------
# PostHog (optional). Leave blank to disable product analytics entirely.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
# Set to "true" only if you want PostHog to run in local dev as well.
NEXT_PUBLIC_POSTHOG_ENABLE_DEV=

# ---------------------------------------------------------------------------
# Calendly (optional). Only used by the apply modal, which the landing page
# does not open — safe to leave blank for this funnel.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CALENDLY_URL=
